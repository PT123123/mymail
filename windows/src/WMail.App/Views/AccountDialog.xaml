<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WMail.App.Views.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加邮箱账户"
    PrimaryButtonText="保存"
    SecondaryButtonText="测试连接"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="8" MinWidth="420">
        <ComboBox x:Name="ProviderBox" Header="服务商预设" SelectedIndex="0" SelectionChanged="OnProviderChanged">
            <ComboBoxItem Content="自定义"/>
            <ComboBoxItem Content="QQ 邮箱"/>
            <ComboBoxItem Content="163 邮箱"/>
            <ComboBoxItem Content="Gmail"/>
            <ComboBoxItem Content="Outlook / M365"/>
        </ComboBox>

        <TextBox x:Name="DisplayNameBox" Header="显示名称(可选)" PlaceholderText="例如:工作邮箱"/>
        <TextBox x:Name="EmailBox" Header="邮箱地址" PlaceholderText="someone@example.com"/>
        <PasswordBox x:Name="PasswordBox" Header="密码 / 授权码" PasswordRevealMode="Peek"/>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ImapHostBox" Header="IMAP 服务器"/>
            <TextBox Grid.Column="1" x:Name="ImapPortBox" Header="端口" Text="993"/>
            <ComboBox Grid.Column="2" x:Name="ImapSecurityBox" Header="IMAP 加密" SelectedIndex="0" VerticalAlignment="Bottom">
                <ComboBoxItem Content="SSL"/>
                <ComboBoxItem Content="STARTTLS"/>
                <ComboBoxItem Content="无"/>
            </ComboBox>
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="SmtpHostBox" Header="SMTP 服务器"/>
            <TextBox Grid.Column="1" x:Name="SmtpPortBox" Header="端口" Text="465"/>
            <ComboBox Grid.Column="2" x:Name="SmtpSecurityBox" Header="SMTP 加密" SelectedIndex="0" VerticalAlignment="Bottom">
                <ComboBoxItem Content="SSL"/>
                <ComboBoxItem Content="STARTTLS"/>
                <ComboBoxItem Content="无"/>
            </ComboBox>
        </Grid>

        <TextBlock x:Name="FeedbackText" FontSize="12" TextWrapping="Wrap" Opacity="0.8"/>
    </StackPanel>
</ContentDialog>
